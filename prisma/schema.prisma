// Prisma supports uuid(4) and uuid(7). The plan asked for a "uuid v6 for
// performance" — time-ordered UUIDs avoid random-index bloat. uuid(7) is the
// time-ordered variant Prisma actually supports, which delivers that benefit.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CisTemplate {
  id        String   @id @default(uuid(7))
  name      String
  content   Json // array of CisTest objects — see plan §3
  createdAt DateTime @default(now())
  assets    Asset[]

  @@index([name])
}

model Asset {
  id        String        @id @default(uuid(7))
  title     String
  ipAddress String
  // SSH account used to connect when scanning this asset. Defaults to "user"
  // so pre-existing rows migrate safely; most audit commands still need
  // privilege, so assets that require root can set their username to root.
  username  String        @default("user")
  cisId     String
  cis       CisTemplate   @relation(fields: [cisId], references: [id])
  createdAt DateTime      @default(now())
  history   ScanHistory[]
}

model ScanHistory {
  id        String   @id @default(uuid(7))
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  score     Int // 0–100, percentage of automated rules passed
  // Full result snapshot (plan §9/§13): the authoritative, server-owned
  // record of which rules passed/failed/errored during THIS scan — including
  // the audit commands, procedure, remediation text as it existed at scan
  // time, and sanitized per-command evidence. The browser never supplies
  // report data; reports are generated from this snapshot by scan id.
  passed    Int      @default(0)
  failed    Int      @default(0)
  errors    Int      @default(0)
  total     Int      @default(0)
  results   Json     @default("[]") // StoredRuleResult[] — see lib/types.ts
  scannedAt DateTime @default(now())

  @@index([assetId])
}